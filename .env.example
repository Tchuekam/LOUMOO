# ═══════════════════════════════════════════════════════════════════════════════
# LOUMOO MASTER BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local and fill in your actual credentials.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server & Application ──
PORT=8080
NODE_ENV=development
APP_NAME="LOUMOO Universal Commerce Platform"
APP_BASE_URL="http://localhost:8080"
CORS_ORIGINS="http://localhost:8080,http://localhost:3000,https://loumoo.cm,https://admin.loumoo.cm"

# ── Supabase (Database, Auth, Storage & Realtime) ──
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_PROJECT_REF="<project-ref>"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_JWT_SECRET="<jwt-secret>"
DATABASE_DIRECT_HOST="db.<project-ref>.supabase.co:5432"
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# ── Clerk (Identity & Access Management) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_APP_ID="app_..."

# ── Redis (Cache, Sessions, Rate Limiting & Pub/Sub) ──
REDIS_URL="redis://default:<password>@<redis-host>:<port>"

# ── AISStream (Maritime & Logistics Transit Telemetry) ──
AISSTREAM_API_KEY="<aisstream-api-key>"

# ── Google Cloud / SMTP App Password ──
GOOGLE_APP_PASSWORD="<google-app-password>"

# ── ElevenLabs (Voice Synthesis & Conversational Audio) ──
ELEVENLABS_API_KEY="sk_..."

# ── PostHog (Product Analytics & Telemetry) ──
POSTHOG_API_KEY="phx_..."
POSTHOG_HOST="https://us.i.posthog.com"

# ── GitHub (VCS, Automation & Deployments) ──
GITHUB_TOKEN="github_pat_..."

# ── Netlify (Edge Hosting & Functions) ──
NETLIFY_AUTH_TOKEN="nfp_..."

# ── Sentry (Error Tracking & Performance APM) ──
SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"

# ── Resend (Transactional Email Delivery) ──
RESEND_API_KEY="re_..."
